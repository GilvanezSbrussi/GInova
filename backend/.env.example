# Nunca commitar o .env real — apenas este exemplo (seção 96 do manual)
#
# ATENÇÃO: conecte-se com a role "ginova_app" (criada em
# database/002_app_role.sql), NUNCA com um superusuário do Postgres.
# Superusuários ignoram Row Level Security — isso quebra o isolamento
# entre empresas (seção 33). Ver README.md > "O que os testes já pegaram".
DATABASE_URL=postgres://ginova_app:troque-esta-senha-em-producao@localhost:5432/ginova
JWT_ACCESS_SECRET=troque-este-valor
JWT_REFRESH_SECRET=troque-este-valor-tambem
PORT=3000
